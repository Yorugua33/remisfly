<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global System - Sistema de Gestión de Remises</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #00f2fe;
            --secondary: #4facfe;
            --accent: #ff007f;
            --bg-dark: #0a0f1d;
            --card-bg: rgba(255, 255, 255, 0.04);
            --card-border: rgba(255, 255, 255, 0.1);
            --text: #ffffff;
            --text-muted: #a0aec0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text);
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 242, 254, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 0, 127, 0.12) 0%, transparent 40%);
            perspective: 1000px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* HEADER & HERO */
        header {
            text-align: center;
            margin-bottom: 60px;
            position: relative;
        }

        .brand-badge {
            display: inline-block;
            padding: 8px 24px;
            background: linear-gradient(90deg, rgba(0,242,254,0.1), rgba(255,0,127,0.1));
            border: 1px solid var(--primary);
            border-radius: 50px;
            color: var(--primary);
            font-weight: 600;
            letter-spacing: 2px;
            font-size: 0.9rem;
            text-transform: uppercase;
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
            margin-bottom: 20px;
        }

        h1 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.2;
            background: linear-gradient(135deg, #ffffff 0%, #a0aec0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
        }

        h1 span {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 1.2rem;
            color: var(--text-muted);
            max-width: 700px;
            margin: 0 auto;
            font-weight: 300;
        }

        /* 3D APPS SECTION */
        .apps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            margin-bottom: 70px;
        }

        .app-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px 30px;
            backdrop-filter: blur(12px);
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            transform-style: preserve-3d;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .app-card:hover {
            transform: translateY(-15px) rotateX(8deg) rotateY(-4deg);
            border-color: var(--primary);
            box-shadow: 0 30px 60px rgba(0, 242, 254, 0.25);
        }

        .card-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #000;
            margin-bottom: 25px;
            box-shadow: 0 10px 20px rgba(0, 242, 254, 0.4);
            transform: translateZ(30px);
        }

        .app-card:nth-child(2) .card-icon {
            background: linear-gradient(135deg, #ff007f, #7928ca);
            color: #fff;
            box-shadow: 0 10px 20px rgba(255, 0, 127, 0.4);
        }

        .app-card:nth-child(3) .card-icon {
            background: linear-gradient(135deg, #00dfa2, #00f2fe);
            color: #000;
            box-shadow: 0 10px 20px rgba(0, 223, 162, 0.4);
        }

        .app-card h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            transform: translateZ(20px);
        }

        .app-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.6;
            transform: translateZ(10px);
        }

        /* FEATURES SECTION */
        .features-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--card-border);
            border-radius: 30px;
            padding: 50px 40px;
            margin-bottom: 70px;
            backdrop-filter: blur(10px);
        }

        .features-title {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 40px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            background: rgba(255, 255, 255, 0.03);
            padding: 20px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: 0.3s;
        }

        .feature-item:hover {
            background: rgba(255, 255, 255, 0.07);
            transform: translateY(-3px);
        }

        .feature-item i {
            font-size: 1.4rem;
            color: var(--primary);
            margin-top: 3px;
        }

        .feature-item div h4 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .feature-item div p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* CONTACT CARD ULTRA 3D */
        .contact-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 30px;
            padding: 50px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6);
        }

        .contact-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
        }

        .contact-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .contact-person {
            font-size: 1.3rem;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 30px;
        }

        .contact-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 35px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 1rem;
        }

        .btn-whatsapp {
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: #fff;
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
        }

        .btn-whatsapp:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(37, 211, 102, 0.6);
        }

        .btn-email {
            background: linear-gradient(135deg, #ea4335, #c5221f);
            color: #fff;
            box-shadow: 0 10px 25px rgba(234, 67, 53, 0.4);
        }

        .btn-email:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(234, 67, 53, 0.6);
        }

        footer {
            text-align: center;
            margin-top: 50px;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            h1 { font-size: 2.2rem; }
            .container { padding: 20px 15px; }
            .features-section { padding: 30px 20px; }
            .contact-buttons { flex-direction: column; }
            .btn { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HEADER -->
        <header>
            <div class="brand-badge"><i class="fa-solid fa-car"></i> Global System</div>
            <h1>El Sistema de Gestión Integral <span>que Esperabas</span></h1>
            <p class="subtitle">Modernizá tu agencia de remises con una plataforma integral de 3 apps perfectamente sincronizadas en tiempo real.</p>
        </header>

        <!-- 3D APPS CARDS -->
        <div class="apps-grid">
            <div class="app-card">
                <div class="card-icon"><i class="fa-solid fa-desktop"></i></div>
                <h3>Panel de Control Base</h3>
                <p>Monitoreo global de la flota, control de viajes en tiempo real, gestión completa de base de datos de pasajeros, cierre de caja automático y emisor de tickets.</p>
            </div>

            <div class="app-card">
                <div class="card-icon"><i class="fa-solid fa-taxi"></i></div>
                <h3>App para el Chofer</h3>
                <p>Recepción instantánea de viajes asignados, navegador GPS integrado para rutas óptimas y comunicación fluida con la central y pasajeros.</p>
            </div>

            <div class="app-card">
                <div class="card-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>
                <h3>App para Pasajeros</h3>
                <p>Permite solicitar viajes en segundos, ver la ubicación exacta del vehículo en el mapa en vivo y mantener contacto directo durante la espera.</p>
            </div>
        </div>

        <!-- FEATURES SECTION -->
        <div class="features-section">
            <h2 class="features-title">Potencia y Tecnología para tu Agencia</h2>
            <div class="features-grid">
                <div class="feature-item">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <h4>Rastreo de Vehículos</h4>
                        <p>Visualización GPS en mapa en vivo de toda la flota.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <i class="fa-solid fa-street-view"></i>
                    <div>
                        <h4>Ubicación de Pasajeros</h4>
                        <p>Geolocalización precisa del cliente para recogidas rápidas.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <i class="fa-solid fa-comments"></i>
                    <div>
                        <h4>Chat Interno Centralizado</h4>
                        <p>Canal de comunicación directo entre base, choferes y clientes.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <i class="fa-solid fa-print"></i>
                    <div>
                        <h4>Impresión de Tickets</h4>
                        <p>Generación de comprobantes y recibos de viaje al instante.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <i class="fa-solid fa-cash-register"></i>
                    <div>
                        <h4>Cierre de Caja</h4>
                        <p>Rendición de cuentas exacta y contabilidad automatizada.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <i class="fa-solid fa-users-gear"></i>
                    <div>
                        <h4>Base de Pasajeros</h4>
                        <p>Registro ordenado de contactos y preferencias de clientes.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTACT SECTION -->
        <div class="contact-card">
            <h2 class="contact-title">¿Listo para transformar tu negocio?</h2>
            <p class="contact-person">Marcelo Muraña — Global System</p>
            
            <div class="contact-buttons">
                <a href="https://wa.me/2254440222" class="btn btn-whatsapp" target="_blank">
                    <i class="fa-brands fa-whatsapp"></i> WhatsApp: 2254440222
                </a>
                <a href="mailto:marcelomur49@gmail.com" class="btn btn-email">
                    <i class="fa-solid fa-envelope"></i> marcelomur49@gmail.com
                </a>
            </div>
        </div>

        <footer>
            <p>&copy; Global System. Todos los derechos reservados.</p>
        </footer>
    </div>

</body>
</html>


